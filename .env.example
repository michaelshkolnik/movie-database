# Copy this file to .env and fill in real values. .env is gitignored.

# --- MySQL (used by docker-compose.yml and application.yml) ---
MYSQL_ROOT_PASSWORD=rootpass
DB_USERNAME=fabflix
DB_PASSWORD=fabflix
DB_URL=jdbc:mysql://localhost:3306/moviedb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8

# --- TMDb (used by scripts/seed_tmdb.py to build db/init/*.sql) ---
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Optional overrides for scripts/seed_tmdb.py (uncomment to change the defaults):
# TMDB_MOVIE_COUNT=300
# TMDB_MIN_VOTES=300
# TMDB_CAST_SIZE=6

# --- Server ---
SERVER_PORT=8080
